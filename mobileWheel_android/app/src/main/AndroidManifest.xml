<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 传感器权限（Android 6.0+ 需要动态申请） -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- 局域网：手机作为 TCP 服务端向 Windows 客户端发送倾斜角 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 震动：电脑端把虚拟手柄收到的震动强度回传过来，手机据此振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 后台保持连接：前台服务 + 熄屏后继续运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_gamepad"
        android:isGame="true"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_gamepad"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileWheel">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.MobileWheel"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台保活：监测 / 局域网开启期间运行，保证退到后台或熄屏后数据不断 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持倾斜角数据持续推送到局域网客户端" />
        </service>
    </application>

</manifest>